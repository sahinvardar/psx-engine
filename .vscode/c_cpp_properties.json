{
	"version": 4,
	"configurations": [
		{
			"name": "PSX (PSn00bSDK 0.24)",
			"compilerPath": "/usr/bin/clang",
			"compilerArgs": [
				"-ffreestanding",
				"-fno-builtin"
			],
			"includePath": [
				"${workspaceFolder}/src",
				"${workspaceFolder}/.vscode/psn00bsdk/include/libpsn00b",
				"${workspaceFolder}/.vscode/psn00bsdk/include/gcc",
				"${workspaceFolder}/.vscode/psn00bsdk/include/target"
			],
			"defines": [
				"PSN00BSDK=1",
				"__mips__=1",
				"__MIPSEL__=1"
			],
			"cStandard": "c11",
			"intelliSenseMode": "macos-clang-arm64",
			"browse": {
				"path": [
					"${workspaceFolder}/src",
					"${workspaceFolder}/.vscode/psn00bsdk/include",
					"${workspaceFolder}/.vscode/psn00bsdk/source/libpsn00b"
				],
				"limitSymbolsToIncludedHeaders": false
			}
		}
	]
}
